# Linux packaging accepts only the shared identity and registry settings: the platform signs
# nothing, publishes no update feed, and carries no mandatory-update policy.
# Reverse-DNS Electron application identifier shared by every platform target.
DSH_DESKTOP_APP_ID=com.deepseek.harness
# npm registry used to materialize the bundled runtime; a local mirror speeds the install.
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
